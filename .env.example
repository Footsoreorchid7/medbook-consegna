# Modello: non contiene segreti. Né Java né Maven caricano automaticamente .env.

# Demo Docker. scripts/demo/configura.sh genera .env con questi valori (letto da Docker Compose)
# e la cartella privata .medbook-demo/ con password casuali: non serve copiare questo file.
MEDBOOK_WEB_PORT=8088
MEDBOOK_TZ=Europe/Rome
MEDBOOK_DEMO_INSTALLAZIONE=<CODICE_ESADECIMALE_DI_32_CARATTERI>
MEDBOOK_SIMULATED_PAYMENT_OUTCOME=PAGATO

# Esecuzione locale senza Docker: esportare esplicitamente le variabili nel terminale che avvia Java.
# MEDBOOK_DB_URL=jdbc:mysql://127.0.0.1:3306/medbook
# MEDBOOK_DB_USERNAME=medbook_user
# MEDBOOK_DB_PASSWORD=<PASSWORD_DATABASE>
# MEDBOOK_HTTP_HOST=127.0.0.1
# MEDBOOK_HTTP_PORT=8080
# MEDBOOK_AUTH_MODE=local-http
# MEDBOOK_AUTH_ORIGIN=http://localhost:5173
# MEDBOOK_REFERTI_DIRECTORY=<DIRECTORY_ASSOLUTA_PRIVATA_ESTERNA_AL_PROGETTO>
# MEDBOOK_QPDF_EXECUTABLE=<PERCORSO_ASSOLUTO_QPDF_12_4_2>
# MEDBOOK_SIMULATED_PAYMENT_OUTCOME=PAGATO
